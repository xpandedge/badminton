rules_version = '2';

// PRD §19 + DELTA_SPEC D5, D6, D8.
// Authoritative writes go through apps/web/src/server/** (firebase-admin, bypasses rules).
// Rules are defense-in-depth: clients may READ, but cannot WRITE matches/leaderboards/global players.
//
// Role tiers (groups/{id}/members.role):
//   owner     - full control
//   admin     - can manage groups and sessions
//   organiser - legacy admin value, retained for compatibility
//   member    - can view, RSVP, and score
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSuperAdminToken() {
      return signedIn() &&
        request.auth.token.email in [
          "pankaj4bharat@gmail.com",
          "sanju36@gmail.com"
        ];
    }
    function isSuperAdminProfile() {
      // Guard: doc may not exist; field may be absent — use .get() to avoid eval errors.
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('emailLower', '') in [
          "pankaj4bharat@gmail.com",
          "sanju36@gmail.com"
        ];
    }
    function isSuperAdmin() {
      return isSuperAdminToken() || isSuperAdminProfile();
    }
    function isGroupActive(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) &&
        !get(/databases/$(database)/documents/groups/$(groupId)).data.keys().hasAny([
          "archivedAt",
          "purgeAfter",
          "archivedBy"
        ]);
    }
    function archiveMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "archivedAt",
        "purgeAfter",
        "archivedBy"
      ]);
    }
    function archiveMetadataAbsent() {
      return !request.resource.data.keys().hasAny([
        "archivedAt",
        "purgeAfter",
        "archivedBy"
      ]);
    }

    // Users can read/write only their own profile (PRD §19.1).
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Global player identity + stats — written only by the server tier (D8).
    // Any signed-in user may read for leaderboard display.
    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if false; // Server tier (admin SDK) only
    }

    // Rate-limit buckets — server-tier internal, never client-accessible.
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      function memberRole() {
        // Use .get() with default to avoid eval error when 'role' field is absent.
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('role', '');
      }
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      function isOwner() { return isMember() && memberRole() == "owner"; }
      // organiser-level: owner or organiser role (PRD §19 three-tier model preserved for direct writes).
      function isAdmin() { return isMember() && memberRole() in ["owner", "admin", "organiser"]; }
      function isNonOwnerAdmin() { return isMember() && memberRole() in ["admin", "organiser"]; }
      function isGroupCreator() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
      }

      allow read: if isSuperAdmin() || isMember() || (request.auth != null && request.auth.uid in resource.data.memberIds);
      // Squad creation goes through createSquad server action; allow here for bootstrap compatibility.
      allow create: if archiveMetadataAbsent() &&
        (isSuperAdmin() || (request.auth != null && request.resource.data.createdBy == request.auth.uid));
      allow update: if isGroupActive(groupId) && archiveMetadataUnchanged() && (isSuperAdmin() || isOwner());
      allow delete: if isGroupActive(groupId) && (isSuperAdmin() || isOwner());

      match /members/{memberId} {
        allow read: if isSuperAdmin() || isMember();
        // Owner can write non-owner member docs. Bootstrap: group creator may write their own first (owner) doc.
        allow create: if isGroupActive(groupId) && (isSuperAdmin()
          || (isOwner() && request.resource.data.get('role', '') != "owner")
          || (isNonOwnerAdmin() && request.resource.data.get('role', '') == "member")
          || (isGroupCreator() && memberId == request.auth.uid));
        allow update: if isGroupActive(groupId) && (isSuperAdmin()
          || (isOwner() && resource.data.get('role', '') != "owner" && request.resource.data.get('role', '') != "owner")
          || (isNonOwnerAdmin() && resource.data.get('role', '') == "member" && request.resource.data.get('role', '') == "member"));
        allow delete: if isGroupActive(groupId) && (isSuperAdmin()
          || (isOwner() && resource.data.get('role', '') != "owner")
          || (isNonOwnerAdmin() && resource.data.get('role', '') == "member"));
      }

      match /players/{playerId} {
        allow read: if isSuperAdmin() || isMember();
        allow write: if isGroupActive(groupId) && (isSuperAdmin() || isAdmin());
      }

      // Self-join requests: any member can see pending requests; all writes
      // (create/approve/reject) go through server actions (admin SDK).
      match /joinRequests/{reqId} {
        allow read: if isSuperAdmin() || isAdmin();
        allow write: if false;
      }

      match /venues/{venueId} {
        allow read: if isSuperAdmin() || isMember();
        allow write: if isGroupActive(groupId) && (isSuperAdmin() || isAdmin());
        match /courts/{courtId} {
          allow read: if isSuperAdmin() || isMember();
          allow write: if isGroupActive(groupId) && (isSuperAdmin() || isAdmin());
        }
      }
    }

    match /sessions/{sessionId} {
      function getSessionGroupId() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data.groupId;
      }
      function getCreateSessionGroupId() {
        return request.resource.data.groupId;
      }
      function sessionMemberRole(groupId) {
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('role', '');
      }
      function isSessionGroupMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(getSessionGroupId())/members/$(request.auth.uid));
      }
      function isSessionGroupActive() {
        return isGroupActive(getSessionGroupId());
      }
      // Owner/admin-level access, including legacy organiser records.
      function isSessionGroupAdmin() {
        return isSessionGroupMember() &&
          sessionMemberRole(getSessionGroupId()) in ["owner", "admin", "organiser"];
      }
      function isCreateSessionGroupAdmin() {
        return request.auth != null &&
          isGroupActive(getCreateSessionGroupId()) &&
          exists(/databases/$(database)/documents/groups/$(getCreateSessionGroupId())/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/groups/$(getCreateSessionGroupId())/members/$(request.auth.uid)).data.get('role', '') in ["owner", "admin", "organiser"];
      }
      function isSessionPlayer() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.auth.uid));
      }

      // Direct client reads are limited to the session's group members and its
      // own players. Public surfaces (board code, score link, RSVP link) read
      // via admin-SDK server actions, so they do not need a client read grant.
      // Writes stay admin-only — all real mutations go through server actions.
      allow read: if isSessionGroupMember() || isSessionPlayer();
      allow create: if isCreateSessionGroupAdmin();
      allow update: if isSessionGroupActive() && isSessionGroupAdmin();

      match /players/{playerId} {
        allow read: if isSessionGroupMember() || request.auth.uid == playerId;
        allow write: if false; // Server tier only (D6, D8)
      }

      // Only organiser+ may read/update join requests; create is server-only (D6).
      match /joinRequests/{reqId} {
        allow read: if isSessionGroupAdmin();
        allow update: if isSessionGroupActive() && isSessionGroupAdmin();
        allow create: if false; // Server tier only (D6)
      }

      // Continuous per-court scheduling: matches live flat, not nested under a
      // round doc — each court has at most one `scheduled` match at a time.
      match /matches/{matchId} {
        allow read: if isSessionGroupMember() || isSessionPlayer();
        allow write: if false; // Server tier only (D8)
      }

      // Persisted fairness bookkeeping (EngineState) — never client-readable,
      // updated incrementally by server actions as courts free up.
      match /engine/{docId} {
        allow read, write: if false;
      }

      match /leaderboard/{playerId} {
        allow read: if isSessionGroupMember() || isSessionPlayer();
        allow write: if false; // Server tier only (D8)
      }

      match /sitOuts/{sitOutId} {
        allow read: if isSessionGroupMember() || isSessionPlayer();
        allow write: if false; // Server tier only
      }

      match /generationRuns/{runId} {
        allow read: if isSessionGroupMember() || isSessionPlayer();
        allow write: if false; // Server tier only
      }

      match /auditLogs/{logId} {
        allow read: if isSessionGroupMember() || isSessionPlayer();
        allow write: if false; // Server tier only
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
