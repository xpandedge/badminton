{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "lib",
    "rootDir": "src",
    "lib": ["ES2022"],
    "target": "ES2022",
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"],
  "references": [
    { "path": "../packages/domain" },
    { "path": "../packages/match-engine" }
  ]
}
